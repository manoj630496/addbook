pipeline {
    agent any

    parameters {
        string(name: 'Env', defaultValue: 'Test', description: 'Enter the envirornment to deploy')

        text(name: 'Jenkins ', defaultValue: '', description: 'Enter some information about the person')

        booleanParam(name: 'tests ', defaultValue: true, description: 'Toggle this value')

        choice(name:'APPVERSION',choices:['1.1','1.2','1.3'])

    }
    stages {
        stage('Compile') {
            steps {
                echo 'Compiling code'
            }
        }
        stage('unit test') {
            steps {
                echo 'Testing code'
            }
        }
        stage('Code Review') {
            steps {
                echo 'Reviewing the code'
            }
        }
        stage('Package') {
            steps {
                echo 'Packaging the code'
            }
        }
        stage('Coverage analysis') {
            steps {
                echo 'Verifying the code'
            }
        }
    }
}